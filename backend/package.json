{
  "name": "arya-tarray-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "member:backfill": "tsx scripts/backfill-member-identities.ts",
    "member:verify": "tsx scripts/verify-member-integrity.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "test": "node --import tsx --test tests/run-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
