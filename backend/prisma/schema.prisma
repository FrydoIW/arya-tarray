generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AccountingAccount {
  assetGainCategories AccountingAssetCategory[] @relation("AssetCategoryGain")
  assetLossCategories AccountingAssetCategory[] @relation("AssetCategoryLoss")
  assetImpairmentExpenses AccountingAssetCategory[] @relation("AssetCategoryImpairmentExpense")
  assetImpairmentAllowances AccountingAssetCategory[] @relation("AssetCategoryImpairmentAllowance")
  assetClearingCategories AccountingAssetCategory[] @relation("AssetCategoryClearing")
  controlledDocuments AccountingDocument[] @relation("AccountingDocumentControl")
  bankSettlements AccountingSettlement[] @relation("AccountingSettlementBankGl")
  draftLines AccountingJournalDraftLine[]
  id                    String                  @id @default(uuid()) @map("accounting_account_id") @db.Char(36)
  code                  String                  @unique(map: "uk_accounting_account_code") @map("account_code") @db.VarChar(10)
  name                  String                  @map("account_name") @db.VarChar(150)
  parentAccountId       String?                 @map("parent_account_id") @db.Char(36)
  accountType           String                  @map("account_type") @db.VarChar(20)
  accountClassification String?                 @map("account_classification") @db.VarChar(40)
  reportSection         String?                 @map("report_section") @db.VarChar(40)
  normalBalance         String                  @map("normal_balance") @db.VarChar(10)
  contraFlag            Boolean                 @default(false) @map("contra_flag")
  postingFlag           Boolean                 @default(true) @map("posting_flag")
  activeFlag            Boolean                 @default(true) @map("active_flag")
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  lines                 AccountingJournalLine[]

  relFkAccAccountParent      AccountingAccount?        @relation("fk_acc_account_parent", fields: [parentAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_account_parent")
  revFkAccAccountParent      AccountingAccount[]       @relation("fk_acc_account_parent")
  revFkAccAssetCatAccum      AccountingAssetCategory[] @relation("fk_acc_asset_cat_accum")
  revFkAccAssetCatAsset      AccountingAssetCategory[] @relation("fk_acc_asset_cat_asset")
  revFkAccAssetCatExp        AccountingAssetCategory[] @relation("fk_acc_asset_cat_exp")
  revFkAccDocLineAccount     AccountingDocumentLine[]  @relation("fk_acc_doc_line_account")
  revFkAccFundAccount        AccountingFund[]          @relation("fk_acc_fund_account")
  revFkAccScheduleBalAccount AccountingSchedule[]      @relation("fk_acc_schedule_bal_account")
  revFkAccScheduleRecAccount AccountingSchedule[]      @relation("fk_acc_schedule_rec_account")

  @@index([parentAccountId], map: "idx_acc_account_parent")
  @@map("arya_accounting_account")
  final26_fk_acc_bank_recon_gl_back AccountingBankReconciliation[] @relation("Final26_fk_acc_bank_recon_gl")
}

/// Every persisted journal is posted. Corrections append evidence; there is no edit/delete API.
model AccountingJournal {
  terminatedSchedules AccountingSchedule[] @relation("AccountingScheduleTermination")
  postedDraft AccountingJournalDraft? @relation("AccountingDraftPosted")
  appliedApproval AccountingApprovalRequest? @relation("AccountingApprovalApplied")
  reversalApprovalRequests AccountingApprovalRequest[] @relation("AccountingApprovalOriginal")
  id                  String                        @id @default(uuid()) @map("accounting_journal_id") @db.Char(36)
  journalNumber       String                        @unique(map: "uk_accounting_journal_number") @map("journal_number") @db.VarChar(60)
  journalType         String                        @map("journal_type") @db.VarChar(20)
  sourceEventKey      String                        @unique(map: "uk_accounting_source_event") @map("source_event_key") @db.VarChar(150)
  accountingDate      DateTime                      @map("accounting_date") @db.Date
  accountingPeriodId  String?                       @map("accounting_period_id") @db.Char(36)
  postedAt            DateTime                      @map("posted_at") @db.DateTime(3)
  descriptionSnapshot String?                       @map("description_snapshot") @db.Text
  bankTransactionId   String?                       @map("bank_transaction_id") @db.Char(36)
  sourceKind          String?                       @map("source_kind") @db.VarChar(30)
  sourceReference     String?                       @map("source_reference") @db.VarChar(150)
  correctionItemId    String?                       @unique(map: "uk_accounting_correction_item") @map("correction_item_id") @db.Char(36)
  relatedJournalId    String?                       @map("related_journal_id") @db.Char(36)
  reversalOfJournalId String?                       @unique(map: "uk_acc_journal_reversal") @map("reversal_of_journal_id") @db.Char(36)
  postedById          String                        @map("posted_by") @db.Char(36)
  createdAt           DateTime                      @default(now()) @map("created_at") @db.DateTime(3)
  bankTransaction     BankTransaction?              @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_journal_transaction")
  correctionItem      ReconciliationCorrectionItem? @relation(fields: [correctionItemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_journal_correction")
  relatedJournal      AccountingJournal?            @relation("AccountingJournalRelationship", fields: [relatedJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_journal_related")
  linkedJournals      AccountingJournal[]           @relation("AccountingJournalRelationship")
  postedBy            User                          @relation("AccountingPostedBy", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_journal_actor")
  lines               AccountingJournalLine[]

  revFkAccDepRunJournal         AccountingDepreciationRun?    @relation("fk_acc_dep_run_journal")
  revFkAccDocJournal            AccountingDocument?           @relation("fk_acc_doc_journal")
  revFkAccDocAdjustJournal      AccountingDocumentAdjustment? @relation("fk_acc_doc_adjust_journal")
  revFkAccFixedAssetDisposal    AccountingFixedAsset?         @relation("fk_acc_fixed_asset_disposal")
  revFkAccFundReleaseJournal    AccountingFundRelease?        @relation("fk_acc_fund_release_journal")
  relFkAccJournalPeriod         AccountingPeriod?             @relation("fk_acc_journal_period", fields: [accountingPeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_journal_period")
  relFkAccJournalReversal       AccountingJournal?            @relation("fk_acc_journal_reversal", fields: [reversalOfJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_journal_reversal")
  revFkAccJournalReversal       AccountingJournal?            @relation("fk_acc_journal_reversal")
  revFkAccOpeningJournal        AccountingOpeningBatch?       @relation("fk_acc_opening_journal")
  revFkAccPeriodCloseJournal    AccountingPeriod[]            @relation("fk_acc_period_close_journal")
  revFkAccSchedulePeriodJournal AccountingSchedulePeriod?     @relation("fk_acc_schedule_period_journal")
  revFkAccSettlementJournal     AccountingSettlement?         @relation("fk_acc_settlement_journal")

  @@index([accountingDate, id], map: "idx_accounting_journal_date")
  @@index([bankTransactionId, postedAt], map: "idx_accounting_journal_source")
  @@index([relatedJournalId], map: "idx_accounting_journal_related")
  @@index([accountingPeriodId, accountingDate], map: "idx_acc_journal_period")
  @@index([sourceKind, sourceReference], map: "idx_acc_journal_source_ref")
  @@map("arya_accounting_journal")
  fund25_fk_acc_restriction_classification_back AccountingFundRestriction? @relation("Fund25_fk_acc_restriction_classification")
}

/// MySQL CHECK constraints for exact nonzero, one-sided lines live in the reviewed physical patch.
model AccountingJournalLine {
  assetSourceClaims AccountingJournalDraft[] @relation("AssetDraftSource")
  assetCostClaims AccountingJournalDraft[] @relation("AssetDraftCost")
  id                      String            @id @default(uuid()) @map("accounting_journal_line_id") @db.Char(36)
  journalId               String            @map("accounting_journal_id") @db.Char(36)
  lineNo                  Int               @map("line_no") @db.UnsignedInt
  accountId               String            @map("accounting_account_id") @db.Char(36)
  accountCodeSnapshot     String            @map("account_code_snapshot") @db.VarChar(10)
  accountNameSnapshot     String            @map("account_name_snapshot") @db.VarChar(150)
  debit                   Decimal           @db.Decimal(20, 2)
  credit                  Decimal           @db.Decimal(20, 2)
  bankAccountId           String?           @map("bank_account_id") @db.Char(36)
  bankNameSnapshot        String?           @map("bank_name_snapshot") @db.VarChar(100)
  bankAccountNoSnapshot   String?           @map("bank_account_no_snapshot") @db.VarChar(100)
  bankAccountNameSnapshot String?           @map("bank_account_name_snapshot") @db.VarChar(200)
  accountingFundId        String?           @map("accounting_fund_id") @db.Char(36)
  fundRestrictionId       String?           @map("fund_restriction_id") @db.Char(36)
  counterpartyId          String?           @map("counterparty_id") @db.Char(36)
  eventCodeId             String?           @map("event_code_id") @db.Char(36)
  eventCodeSnapshot       String?           @map("event_code_snapshot") @db.Char(3)
  eventNameSnapshot       String?           @map("event_name_snapshot") @db.VarChar(200)
  eventTypeSnapshot       String?           @map("event_type_snapshot") @db.VarChar(20)
  eventCampaignId         String?           @map("event_campaign_id") @db.Char(36)
  campaignNameSnapshot    String?           @map("campaign_name_snapshot") @db.VarChar(200)
  memberIdentityId        String?           @map("member_identity_id") @db.Char(36)
  donorNameSnapshot       String?           @map("donor_name_snapshot") @db.VarChar(255)
  memberId                String?           @map("member_id") @db.Char(36)
  memberCodeSnapshot      String?           @map("member_code_snapshot") @db.VarChar(30)
  memberNameSnapshot      String?           @map("member_name_snapshot") @db.VarChar(150)
  createdAt               DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  journal                 AccountingJournal @relation(fields: [journalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_journal")
  account                 AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_account")
  bankAccount             BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_bank")
  eventCode               EventCode?        @relation(fields: [eventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_event")
  eventCampaign           EventCampaign?    @relation(fields: [eventCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_campaign")
  memberIdentity          MemberIdentity?   @relation(fields: [memberIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_identity")
  member                  Member?           @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_line_member")

  revFkAccBankMatchLine       AccountingBankReconciliationMatch[] @relation("fk_acc_bank_match_line")
  revFkAccDepRunAssetAccum    AccountingDepreciationRunAsset?     @relation("fk_acc_dep_run_asset_accum")
  revFkAccDepRunAssetExp      AccountingDepreciationRunAsset?     @relation("fk_acc_dep_run_asset_exp")
  revFkAccFixedAssetSource    AccountingFixedAsset?               @relation("fk_acc_fixed_asset_source")
  relFkAccLineCounterparty    AccountingCounterparty?             @relation("fk_acc_line_counterparty", fields: [counterpartyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_line_counterparty")
  relFkAccLineFund            AccountingFund?                     @relation("fk_acc_line_fund", fields: [accountingFundId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_line_fund")
  relFkAccLineRestrictionFund AccountingFundRestriction?          @relation("fk_acc_line_restriction_fund", fields: [fundRestrictionId, accountingFundId], references: [id, accountingFundId], onDelete: Restrict, onUpdate: Restrict, map: "fk_acc_line_restriction_fund")
  revFkAccScheduleSource      AccountingSchedule[]                @relation("fk_acc_schedule_source")

  @@unique([journalId, lineNo], map: "uk_accounting_line_number")
  @@index([accountId, journalId], map: "idx_accounting_line_account")
  @@index([bankAccountId], map: "idx_accounting_line_bank")
  @@index([eventCodeId], map: "idx_accounting_line_event")
  @@index([eventCampaignId], map: "idx_accounting_line_campaign")
  @@index([memberId], map: "idx_accounting_line_member")
  @@index([accountingFundId], map: "idx_acc_line_fund")
  @@index([fundRestrictionId, accountingFundId], map: "idx_acc_line_restriction")
  @@index([counterpartyId], map: "idx_acc_line_counterparty")
  @@map("arya_accounting_journal_line")
  fund25_fk_acc_restriction_source_line_back AccountingFundRestriction[] @relation("Fund25_fk_acc_restriction_source_line")
  fund25_fk_acc_release_evidence_back AccountingFundRelease[] @relation("Fund25_fk_acc_release_evidence")
  fund25_fk_acc_draft_fund_source_back AccountingJournalDraft[] @relation("Fund25_fk_acc_draft_fund_source")
  fund25_fk_acc_approval_release_evidence_back AccountingApprovalRequest[] @relation("Fund25_fk_acc_approval_release_evidence")
}

model Member {
  accountingLines AccountingJournalLine[]
  id String @id @default(uuid()) @map("member_id") @db.Char(36)
  memberCode String @unique(map: "uk_member_code") @map("member_code") @db.VarChar(30)
  memberName String @map("member_name") @db.VarChar(150)
  initialName String? @map("initial_name") @db.VarChar(100)
  birthDate DateTime? @map("birth_date") @db.Date
  phone String? @db.VarChar(50)
  email String? @db.VarChar(150)
  address String? @db.VarChar(500)
  city String? @db.VarChar(100)
  registrationSource String @default("MANUAL") @map("registration_source") @db.VarChar(20)
  activeFlag Boolean @default(true) @map("active_flag")
  remark String? @db.VarChar(500)
  registeredAt DateTime @default(now()) @map("registered_at") @db.DateTime(3)
  registeredById String? @map("registered_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById String? @map("updated_by") @db.Char(36)
  registeredBy User? @relation("MemberRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_registered_by")
  createdBy User? @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_created_by")
  updatedBy User? @relation("MemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_updated_by")
  identities MemberIdentity[]
  identityHistoryFrom MemberIdentityHistory[] @relation("MemberIdentityHistoryFromMember")
  identityHistoryTo   MemberIdentityHistory[] @relation("MemberIdentityHistoryToMember")
  eventSubscriptions MemberEventSubscription[]
  carryTransfers MemberEventCarryTransfer[] @relation("MemberEventCarryTransferMember")
  campaignAllocations MemberEventCampaignAllocation[]
  campaignWalletEntries MemberEventCampaignWalletLedger[]
  campaignParticipations MemberEventCampaignParticipation[]
  revFkAccCounterpartyMember AccountingCounterparty?     @relation("fk_acc_counterparty_member")
  revFkAccRestrictionDonor   AccountingFundRestriction[] @relation("fk_acc_restriction_donor")
  @@index([memberName], map: "idx_member_name")
  @@index([initialName], map: "idx_member_initial_name")
  @@index([city], map: "idx_member_city")
  @@index([activeFlag], map: "idx_member_active")
  @@index([registeredById], map: "fk_member_registered_by")
  @@index([createdById], map: "fk_member_created_by")
  @@index([updatedById], map: "fk_member_updated_by")
  @@map("arya_member")
}

model MemberIdentity {
  accountingLines AccountingJournalLine[]
  id String @id @default(uuid()) @map("member_identity_id") @db.Char(36)
  memberId String? @map("member_id") @db.Char(36)
  sourceType String @default("STATEMENT") @map("source_type") @db.VarChar(20)
  bankName String? @map("bank_name") @db.VarChar(100)
  accountNumber String? @map("account_number") @db.VarChar(100)
  accountType String? @map("account_type") @db.VarChar(100)
  accountName String @map("account_name") @db.VarChar(200)
  initialName String? @map("initial_name") @db.VarChar(100)
  normalizedName String @map("normalized_name") @db.VarChar(200)
  identityKey String @unique(map: "uk_member_identity_key") @map("identity_key") @db.VarChar(191)
  verificationStatus String @default("UNVERIFIED") @map("verification_status") @db.VarChar(20)
  firstSeenStatementUploadId String? @map("first_seen_statement_upload_id") @db.Char(36)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.DateTime(3)
  verifiedAt DateTime? @map("verified_at") @db.DateTime(3)
  verifiedById String? @map("verified_by") @db.Char(36)
  remark String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById String? @map("updated_by") @db.Char(36)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_member")
  firstSeenStatement BankStatementUpload? @relation(fields: [firstSeenStatementUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_first_statement")
  verifiedBy User? @relation("MemberIdentityVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_verified_by")
  createdBy User? @relation("MemberIdentityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_created_by")
  updatedBy User? @relation("MemberIdentityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_updated_by")
  transactions BankTransaction[]
  ownershipHistory MemberIdentityHistory[]
  @@index([memberId], map: "idx_member_identity_member")
  @@index([verificationStatus], map: "idx_member_identity_status")
  @@index([normalizedName], map: "idx_member_identity_normalized_name")
  @@index([accountName], map: "idx_member_identity_account_name")
  @@index([accountNumber], map: "idx_member_identity_account_number")
  @@index([lastSeenAt], map: "idx_member_identity_last_seen")
  @@index([firstSeenStatementUploadId], map: "fk_member_identity_first_statement")
  @@index([verifiedById], map: "fk_member_identity_verified_by")
  @@index([createdById], map: "fk_member_identity_created_by")
  @@index([updatedById], map: "fk_member_identity_updated_by")
  @@map("arya_member_identity")
}

model MemberIdentityHistory {
  id               String   @id @default(uuid()) @map("member_identity_history_id") @db.Char(36)
  memberIdentityId String   @map("member_identity_id") @db.Char(36)
  action           String   @db.VarChar(20)
  fromMemberId     String?  @map("from_member_id") @db.Char(36)
  toMemberId       String?  @map("to_member_id") @db.Char(36)
  statusBefore     String   @map("status_before") @db.VarChar(20)
  statusAfter      String   @map("status_after") @db.VarChar(20)
  reason           String?  @db.VarChar(1000)
  actionAt         DateTime @default(now()) @map("action_at") @db.DateTime(3)
  actionById       String   @map("action_by") @db.Char(36)

  memberIdentity MemberIdentity @relation(fields: [memberIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_identity")
  fromMember     Member?        @relation("MemberIdentityHistoryFromMember", fields: [fromMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_from_member")
  toMember       Member?        @relation("MemberIdentityHistoryToMember", fields: [toMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_to_member")
  actionBy       User           @relation("MemberIdentityHistoryActionBy", fields: [actionById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_action_by")

  @@index([memberIdentityId, actionAt], map: "idx_member_identity_history_identity_action_at")
  @@index([fromMemberId, actionAt], map: "idx_member_identity_history_from_member")
  @@index([toMemberId, actionAt], map: "idx_member_identity_history_to_member")
  @@index([actionById], map: "idx_member_identity_history_action_by")
  @@map("arya_member_identity_history")
}

model Role {
  id          String   @id @default(uuid()) @map("role_id") @db.Char(36)
  roleCode    String   @map("role_code") @db.VarChar(50)
  roleName    String   @map("role_name") @db.VarChar(100)
  description String?  @db.VarChar(255)
  activeFlag  Boolean  @default(true) @map("active_flag")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  createdBy User?      @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy User?      @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  userRoles UserRole[]
  roleMenus RoleMenu[]

  @@map("arya_role")
}

model User {
  custodiedAssets AccountingFixedAsset[] @relation("AssetCustodian")
  createdAssets AccountingFixedAsset[] @relation("AssetCreator")
  updatedAssets AccountingFixedAsset[] @relation("AssetUpdater")
  accountingDrafts AccountingJournalDraft[] @relation("AccountingDraftCreator")
  requestedAccountingApprovals AccountingApprovalRequest[] @relation("AccountingApprovalRequester")
  decidedAccountingApprovals AccountingApprovalRequest[] @relation("AccountingApprovalDecider")
  appliedAccountingApprovals AccountingApprovalRequest[] @relation("AccountingApprovalApplier")
  accountingApprovalAssignments AccountingApprovalApprover[]
  accountingApprovalHistory AccountingApprovalHistory[]
  postedAccountingJournals AccountingJournal[] @relation("AccountingPostedBy")
  registeredMembers Member[] @relation("MemberRegisteredBy")
  createdMembers Member[] @relation("MemberCreatedBy")
  updatedMembers Member[] @relation("MemberUpdatedBy")
  verifiedMemberIdentities MemberIdentity[] @relation("MemberIdentityVerifiedBy")
  createdMemberIdentities MemberIdentity[] @relation("MemberIdentityCreatedBy")
  updatedMemberIdentities MemberIdentity[] @relation("MemberIdentityUpdatedBy")
  memberIdentityHistoryActions MemberIdentityHistory[] @relation("MemberIdentityHistoryActionBy")
  createdEventCampaigns EventCampaign[] @relation("EventCampaignCreatedBy")
  updatedEventCampaigns EventCampaign[] @relation("EventCampaignUpdatedBy")
  createdEventTimeRules EventTimeRule[] @relation("EventTimeRuleCreatedBy")
  updatedEventTimeRules EventTimeRule[] @relation("EventTimeRuleUpdatedBy")
  createdMemberEventSubscriptions MemberEventSubscription[] @relation("MemberEventSubscriptionCreatedBy")
  updatedMemberEventSubscriptions MemberEventSubscription[] @relation("MemberEventSubscriptionUpdatedBy")
  createdMemberEventCoverages MemberEventCoverage[] @relation("MemberEventCoverageCreatedBy")
  voidedMemberEventCoverages MemberEventCoverage[] @relation("MemberEventCoverageVoidedBy")
  createdMemberEventBalanceEntries MemberEventBalanceLedger[] @relation("MemberEventBalanceCreatedBy")
  voidedMemberEventBalanceEntries MemberEventBalanceLedger[] @relation("MemberEventBalanceVoidedBy")
  createdMemberEventCarryTransfers MemberEventCarryTransfer[] @relation("MemberEventCarryTransferCreatedBy")
  reversedMemberEventCarryTransfers MemberEventCarryTransfer[] @relation("MemberEventCarryTransferReversedBy")
  createdMemberEventCampaignAllocations MemberEventCampaignAllocation[] @relation("MemberEventCampaignAllocationCreatedBy")
  voidedMemberEventCampaignAllocations MemberEventCampaignAllocation[] @relation("MemberEventCampaignAllocationVoidedBy")
  createdMemberEventCampaignWalletEntries MemberEventCampaignWalletLedger[] @relation("MemberEventCampaignWalletLedgerCreatedBy")
  voidedMemberEventCampaignWalletEntries MemberEventCampaignWalletLedger[] @relation("MemberEventCampaignWalletLedgerVoidedBy")
  createdMemberEventCampaignParticipations MemberEventCampaignParticipation[] @relation("MemberEventCampaignParticipationCreatedBy")
  id           String   @id @default(uuid()) @map("user_id") @db.Char(36)
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdById  String?  @map("created_by") @db.Char(36)
  updatedById  String?  @map("updated_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  createdBy              User?                          @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?                          @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers           User[]                         @relation("UserCreatedBy")
