generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id String @id @default(uuid()) @map("member_id") @db.Char(36)
  memberCode String @unique(map: "uk_member_code") @map("member_code") @db.VarChar(30)
  memberName String @map("member_name") @db.VarChar(150)
  initialName String? @map("initial_name") @db.VarChar(100)
  birthDate DateTime? @map("birth_date") @db.Date
  phone String? @db.VarChar(50)
  email String? @db.VarChar(150)
  address String? @db.VarChar(500)
  city String? @db.VarChar(100)
  registrationSource String @default("MANUAL") @map("registration_source") @db.VarChar(20)
  activeFlag Boolean @default(true) @map("active_flag")
  remark String? @db.VarChar(500)
  registeredAt DateTime @default(now()) @map("registered_at") @db.DateTime(3)
  registeredById String? @map("registered_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById String? @map("updated_by") @db.Char(36)
  registeredBy User? @relation("MemberRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_registered_by")
  createdBy User? @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_created_by")
  updatedBy User? @relation("MemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_updated_by")
  identities MemberIdentity[]
  identityHistoryFrom MemberIdentityHistory[] @relation("MemberIdentityHistoryFromMember")
  identityHistoryTo   MemberIdentityHistory[] @relation("MemberIdentityHistoryToMember")
  eventSubscriptions MemberEventSubscription[]
  @@index([memberName], map: "idx_member_name")
  @@index([initialName], map: "idx_member_initial_name")
  @@index([city], map: "idx_member_city")
  @@index([activeFlag], map: "idx_member_active")
  @@index([registeredById], map: "fk_member_registered_by")
  @@index([createdById], map: "fk_member_created_by")
  @@index([updatedById], map: "fk_member_updated_by")
  @@map("arya_member")
}

model MemberIdentity {
  id String @id @default(uuid()) @map("member_identity_id") @db.Char(36)
  memberId String? @map("member_id") @db.Char(36)
  sourceType String @default("STATEMENT") @map("source_type") @db.VarChar(20)
  bankName String? @map("bank_name") @db.VarChar(100)
  accountNumber String? @map("account_number") @db.VarChar(100)
  accountType String? @map("account_type") @db.VarChar(100)
  accountName String @map("account_name") @db.VarChar(200)
  initialName String? @map("initial_name") @db.VarChar(100)
  normalizedName String @map("normalized_name") @db.VarChar(200)
  identityKey String @unique(map: "uk_member_identity_key") @map("identity_key") @db.VarChar(191)
  verificationStatus String @default("UNVERIFIED") @map("verification_status") @db.VarChar(20)
  firstSeenStatementUploadId String? @map("first_seen_statement_upload_id") @db.Char(36)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.DateTime(3)
  verifiedAt DateTime? @map("verified_at") @db.DateTime(3)
  verifiedById String? @map("verified_by") @db.Char(36)
  remark String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById String? @map("updated_by") @db.Char(36)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_member")
  firstSeenStatement BankStatementUpload? @relation(fields: [firstSeenStatementUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_first_statement")
  verifiedBy User? @relation("MemberIdentityVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_verified_by")
  createdBy User? @relation("MemberIdentityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_created_by")
  updatedBy User? @relation("MemberIdentityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_updated_by")
  transactions BankTransaction[]
  ownershipHistory MemberIdentityHistory[]
  @@index([memberId], map: "idx_member_identity_member")
  @@index([verificationStatus], map: "idx_member_identity_status")
  @@index([normalizedName], map: "idx_member_identity_normalized_name")
  @@index([accountName], map: "idx_member_identity_account_name")
  @@index([accountNumber], map: "idx_member_identity_account_number")
  @@index([lastSeenAt], map: "idx_member_identity_last_seen")
  @@index([firstSeenStatementUploadId], map: "fk_member_identity_first_statement")
  @@index([verifiedById], map: "fk_member_identity_verified_by")
  @@index([createdById], map: "fk_member_identity_created_by")
  @@index([updatedById], map: "fk_member_identity_updated_by")
  @@map("arya_member_identity")
}

model MemberIdentityHistory {
  id               String   @id @default(uuid()) @map("member_identity_history_id") @db.Char(36)
  memberIdentityId String   @map("member_identity_id") @db.Char(36)
  action           String   @db.VarChar(20)
  fromMemberId     String?  @map("from_member_id") @db.Char(36)
  toMemberId       String?  @map("to_member_id") @db.Char(36)
  statusBefore     String   @map("status_before") @db.VarChar(20)
  statusAfter      String   @map("status_after") @db.VarChar(20)
  reason           String?  @db.VarChar(1000)
  actionAt         DateTime @default(now()) @map("action_at") @db.DateTime(3)
  actionById       String   @map("action_by") @db.Char(36)

  memberIdentity MemberIdentity @relation(fields: [memberIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_identity")
  fromMember     Member?        @relation("MemberIdentityHistoryFromMember", fields: [fromMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_from_member")
  toMember       Member?        @relation("MemberIdentityHistoryToMember", fields: [toMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_to_member")
  actionBy       User           @relation("MemberIdentityHistoryActionBy", fields: [actionById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_identity_history_action_by")

  @@index([memberIdentityId, actionAt], map: "idx_member_identity_history_identity_action_at")
  @@index([fromMemberId, actionAt], map: "idx_member_identity_history_from_member")
  @@index([toMemberId, actionAt], map: "idx_member_identity_history_to_member")
  @@index([actionById], map: "idx_member_identity_history_action_by")
  @@map("arya_member_identity_history")
}

model Role {
  id          String   @id @default(uuid()) @map("role_id") @db.Char(36)
  roleCode    String   @map("role_code") @db.VarChar(50)
  roleName    String   @map("role_name") @db.VarChar(100)
  description String?  @db.VarChar(255)
  activeFlag  Boolean  @default(true) @map("active_flag")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  createdBy User?      @relation("RoleCreatedBy", fields: [createdById], references: [id])
  updatedBy User?      @relation("RoleUpdatedBy", fields: [updatedById], references: [id])
  userRoles UserRole[]
  roleMenus RoleMenu[]

  @@map("arya_role")
}

model User {
  registeredMembers Member[] @relation("MemberRegisteredBy")
  createdMembers Member[] @relation("MemberCreatedBy")
  updatedMembers Member[] @relation("MemberUpdatedBy")
  verifiedMemberIdentities MemberIdentity[] @relation("MemberIdentityVerifiedBy")
  createdMemberIdentities MemberIdentity[] @relation("MemberIdentityCreatedBy")
  updatedMemberIdentities MemberIdentity[] @relation("MemberIdentityUpdatedBy")
  memberIdentityHistoryActions MemberIdentityHistory[] @relation("MemberIdentityHistoryActionBy")
  createdEventCampaigns EventCampaign[] @relation("EventCampaignCreatedBy")
  updatedEventCampaigns EventCampaign[] @relation("EventCampaignUpdatedBy")
  createdEventTimeRules EventTimeRule[] @relation("EventTimeRuleCreatedBy")
  updatedEventTimeRules EventTimeRule[] @relation("EventTimeRuleUpdatedBy")
  createdMemberEventSubscriptions MemberEventSubscription[] @relation("MemberEventSubscriptionCreatedBy")
  updatedMemberEventSubscriptions MemberEventSubscription[] @relation("MemberEventSubscriptionUpdatedBy")
  createdMemberEventCoverages MemberEventCoverage[] @relation("MemberEventCoverageCreatedBy")
  voidedMemberEventCoverages MemberEventCoverage[] @relation("MemberEventCoverageVoidedBy")
  createdMemberEventBalanceEntries MemberEventBalanceLedger[] @relation("MemberEventBalanceCreatedBy")
  voidedMemberEventBalanceEntries MemberEventBalanceLedger[] @relation("MemberEventBalanceVoidedBy")
  id           String   @id @default(uuid()) @map("user_id") @db.Char(36)
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdById  String?  @map("created_by") @db.Char(36)
  updatedById  String?  @map("updated_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  createdBy              User?                          @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?                          @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers           User[]                         @relation("UserCreatedBy")
  updatedUsers           User[]                         @relation("UserUpdatedBy")
  userRoles              UserRole[]
  createdRoles           Role[]                         @relation("RoleCreatedBy")
  updatedRoles           Role[]                         @relation("RoleUpdatedBy")
  createdEventCodes      EventCode[]                    @relation("EventCodeCreatedBy")
  updatedEventCodes      EventCode[]                    @relation("EventCodeUpdatedBy")
  createdBankAccounts    BankAccount[]                  @relation("BankAccountCreatedBy")
  updatedBankAccounts    BankAccount[]                  @relation("BankAccountUpdatedBy")
  uploadedStatements     BankStatementUpload[]          @relation("StatementUploadedBy")
  executedStatements     BankStatementUpload[]          @relation("StatementExecutedBy")
  finalizedStatements    BankStatementUpload[]          @relation("StatementFinalizedBy")
  transactionHistory     BankTransactionHistory[]       @relation("TransactionHistoryChangedBy")
  submittedApprovals     ReconciliationApproval[]       @relation("ApprovalSubmittedBy")
  decidedApprovals       ReconciliationApproval[]       @relation("ApprovalDecidedBy")
  reconciliationApprovalAssignments ReconciliationApprovalApprover[] @relation("ReconciliationApprovalApproverUser")
  proposedReconciliationCorrections ReconciliationCorrectionProposal[] @relation("ReconciliationCorrectionProposedBy")
  decidedReconciliationCorrections ReconciliationCorrectionProposal[] @relation("ReconciliationCorrectionDecidedBy")
  reconciliationCorrectionAssignments ReconciliationCorrectionApprover[] @relation("ReconciliationCorrectionApproverUser")
  manualBankTransactions BankTransaction[] @relation("BankTransactionManualAddedBy")
  excludedBankTransactions BankTransaction[] @relation("BankTransactionExcludedBy")
  approvalHistoryActions          ReconciliationApprovalHistory[] @relation("ApprovalHistoryActionBy")
  createdApprovalConfigs          ApprovalConfig[]                @relation("ApprovalConfigCreatedBy")
  updatedApprovalConfigs          ApprovalConfig[]                @relation("ApprovalConfigUpdatedBy")
  approvalConfigAssignments       ApprovalConfigApprover[]        @relation("ApprovalConfigApproverUser")
  createdApprovalConfigAssignments ApprovalConfigApprover[]       @relation("ApprovalConfigApproverCreatedBy")
  createdMenus                    Menu[]                           @relation("MenuCreatedBy")
  updatedMenus           Menu[]                         @relation("MenuUpdatedBy")
  createdRoleMenus       RoleMenu[]                     @relation("RoleMenuCreatedBy")

  @@map("arya_user")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("arya_user_role")
}

model Menu {
  id            String   @id @default(uuid()) @map("menu_id") @db.Char(36)
  parentMenuId  String?  @map("parent_menu_id") @db.Char(36)
  menuCode      String   @map("menu_code") @db.VarChar(100)
  menuName      String   @map("menu_name") @db.VarChar(150)
  route         String?  @db.VarChar(255)
  menuType      String   @map("menu_type") @db.VarChar(20)
  displayOrder  Int      @default(0) @map("display_order")
  activeFlag    Boolean  @default(true) @map("active_flag")
  createdById   String?  @map("created_by") @db.Char(36)
  updatedById   String?  @map("updated_by") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  parent     Menu?      @relation("MenuHierarchy", fields: [parentMenuId], references: [id])
  children   Menu[]     @relation("MenuHierarchy")
  createdBy  User?      @relation("MenuCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?           @relation("MenuUpdatedBy", fields: [updatedById], references: [id])
  roleMenus      RoleMenu[]
  approvalConfig ApprovalConfig?

  @@map("arya_menu")
}

model RoleMenu {
  roleId      String   @map("role_id") @db.Char(36)
  menuId      String   @map("menu_id") @db.Char(36)
  createdById String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  role      Role  @relation(fields: [roleId], references: [id])
  menu      Menu  @relation(fields: [menuId], references: [id])
  createdBy User? @relation("RoleMenuCreatedBy", fields: [createdById], references: [id])

  @@id([roleId, menuId])
  @@map("arya_role_menu")
}

model EventCode {
  id          String   @id @default(uuid()) @map("event_code_id") @db.Char(36)
  code        String   @db.Char(3)
  eventName   String   @map("event_name") @db.VarChar(150)
  category    String?  @db.VarChar(50)
  eventType   String   @default("STANDARD") @map("event_type") @db.VarChar(20)
  description String?  @db.VarChar(500)
  activeFlag  Boolean  @default(true) @map("active_flag")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  createdById String?  @map("created_by") @db.Char(36)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  updatedById String?  @map("updated_by") @db.Char(36)

  createdBy             User?             @relation("EventCodeCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?             @relation("EventCodeUpdatedBy", fields: [updatedById], references: [id])
  suggestedTransactions BankTransaction[] @relation("SuggestedEventCode")
  transactions          BankTransaction[] @relation("FinalEventCode")
  correctionItemsBefore ReconciliationCorrectionItem[] @relation("CorrectionBeforeEventCode")
  correctionItemsProposed ReconciliationCorrectionItem[] @relation("CorrectionProposedEventCode")
  campaigns EventCampaign[]
  timeRule EventTimeRule?
  memberSubscriptions MemberEventSubscription[]

  @@index([eventType], map: "idx_event_code_type")
  @@map("arya_event_code")
}

model EventCampaign {
  id String @id @default(uuid()) @map("event_campaign_id") @db.Char(36)
  eventCodeId String @map("event_code_id") @db.Char(36)
  campaignName String @map("campaign_name") @db.VarChar(200)
  startDate DateTime? @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  targetAmount Decimal? @map("target_amount") @db.Decimal(20, 2)
  activeFlag Boolean @default(true) @map("active_flag")
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  updatedById String? @map("updated_by") @db.Char(36)

  eventCode EventCode @relation(fields: [eventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_campaign_event_code")
  createdBy User? @relation("EventCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_campaign_created_by")
  updatedBy User? @relation("EventCampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_campaign_updated_by")
  transactions BankTransaction[]
  correctionItemsBefore ReconciliationCorrectionItem[] @relation("CorrectionBeforeEventCampaign")
  correctionItemsProposed ReconciliationCorrectionItem[] @relation("CorrectionProposedEventCampaign")

  @@index([eventCodeId, activeFlag], map: "idx_event_campaign_event_active")
  @@index([startDate, endDate], map: "idx_event_campaign_period")
  @@index([createdById], map: "idx_event_campaign_created_by")
  @@index([updatedById], map: "idx_event_campaign_updated_by")
  @@map("arya_event_campaign")
}

model EventTimeRule {
  eventCodeId String @id @map("event_code_id") @db.Char(36)
  unitAmount Decimal @map("unit_amount") @db.Decimal(20, 2)
  durationMonths Int @default(1) @map("duration_months") @db.UnsignedInt
  activeFlag Boolean @default(true) @map("active_flag")
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  updatedById String? @map("updated_by") @db.Char(36)

  eventCode EventCode @relation(fields: [eventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_time_rule_event_code")
  createdBy User? @relation("EventTimeRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_time_rule_created_by")
  updatedBy User? @relation("EventTimeRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_event_time_rule_updated_by")

  @@index([createdById], map: "idx_event_time_rule_created_by")
  @@index([updatedById], map: "idx_event_time_rule_updated_by")
  @@map("arya_event_time_rule")
}

model MemberEventSubscription {
  id String @id @default(uuid()) @map("member_event_subscription_id") @db.Char(36)
  memberId String @map("member_id") @db.Char(36)
  eventCodeId String @map("event_code_id") @db.Char(36)
  referenceNo String? @map("reference_no") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(200)
  startDate DateTime? @map("start_date") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  activeFlag Boolean @default(true) @map("active_flag")
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById String? @map("updated_by") @db.Char(36)

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_sub_member")
  eventCode EventCode @relation(fields: [eventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_sub_event_code")
  createdBy User? @relation("MemberEventSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_sub_created_by")
  updatedBy User? @relation("MemberEventSubscriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_sub_updated_by")
  coverages MemberEventCoverage[]
  balanceLedger MemberEventBalanceLedger[]

  @@index([memberId, eventCodeId, activeFlag], map: "idx_member_event_sub_member_event")
  @@index([eventCodeId, activeFlag], map: "idx_member_event_sub_event")
  @@index([referenceNo], map: "idx_member_event_sub_reference")
  @@index([validUntil], map: "idx_member_event_sub_valid_until")
  @@index([createdById], map: "idx_member_event_sub_created_by")
  @@index([updatedById], map: "idx_member_event_sub_updated_by")
  @@map("arya_member_event_subscription")
}

model MemberEventCoverage {
  id String @id @default(uuid()) @map("member_event_coverage_id") @db.Char(36)
  subscriptionId String @map("member_event_subscription_id") @db.Char(36)
  bankTransactionId String? @map("bank_transaction_id") @db.Char(36)
  coverageSource String @default("TRANSACTION") @map("coverage_source") @db.VarChar(20)
  coverageStatus String @default("ACTIVE") @map("coverage_status") @db.VarChar(20)
  unitAmountSnapshot Decimal? @map("unit_amount_snapshot") @db.Decimal(20, 2)
  durationMonthsSnapshot Int? @map("duration_months_snapshot") @db.UnsignedInt
  grantedUnits Int? @map("granted_units") @db.UnsignedInt
  amountApplied Decimal? @map("amount_applied") @db.Decimal(20, 2)
  coverageFrom DateTime @map("coverage_from") @db.Date
  coverageTo DateTime @map("coverage_to") @db.Date
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  voidedAt DateTime? @map("voided_at") @db.DateTime(3)
  voidedById String? @map("voided_by") @db.Char(36)
  voidReason String? @map("void_reason") @db.VarChar(1000)

  subscription MemberEventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_cov_subscription")
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_cov_transaction")
  createdBy User? @relation("MemberEventCoverageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_cov_created_by")
  voidedBy User? @relation("MemberEventCoverageVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_cov_voided_by")
  balanceLedger MemberEventBalanceLedger[]

  @@index([subscriptionId, coverageStatus, coverageTo], map: "idx_member_event_cov_subscription")
  @@index([bankTransactionId], map: "idx_member_event_cov_transaction")
  @@index([coverageFrom, coverageTo], map: "idx_member_event_cov_period")
  @@index([createdById], map: "idx_member_event_cov_created_by")
  @@index([voidedById], map: "idx_member_event_cov_voided_by")
  @@map("arya_member_event_coverage")
}

model MemberEventBalanceLedger {
  id String @id @default(uuid()) @map("member_event_balance_ledger_id") @db.Char(36)
  subscriptionId String @map("member_event_subscription_id") @db.Char(36)
  bankTransactionId String? @map("bank_transaction_id") @db.Char(36)
  coverageId String? @map("member_event_coverage_id") @db.Char(36)
  entryType String @map("entry_type") @db.VarChar(20)
  entryStatus String @default("ACTIVE") @map("entry_status") @db.VarChar(20)
  amountDelta Decimal @map("amount_delta") @db.Decimal(20, 2)
  effectiveDate DateTime @map("effective_date") @db.Date
  unitAmountSnapshot Decimal? @map("unit_amount_snapshot") @db.Decimal(20, 2)
  durationMonthsSnapshot Int? @map("duration_months_snapshot") @db.UnsignedInt
  remark String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdById String? @map("created_by") @db.Char(36)
  voidedAt DateTime? @map("voided_at") @db.DateTime(3)
  voidedById String? @map("voided_by") @db.Char(36)
  voidReason String? @map("void_reason") @db.VarChar(1000)

  subscription MemberEventSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_balance_subscription")
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_balance_transaction")
  coverage MemberEventCoverage? @relation(fields: [coverageId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_balance_coverage")
  createdBy User? @relation("MemberEventBalanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_balance_created_by")
  voidedBy User? @relation("MemberEventBalanceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_member_event_balance_voided_by")

  @@index([subscriptionId, entryStatus, effectiveDate], map: "idx_member_event_balance_subscription")
  @@index([bankTransactionId], map: "idx_member_event_balance_transaction")
  @@index([coverageId], map: "idx_member_event_balance_coverage")
  @@index([entryType, entryStatus], map: "idx_member_event_balance_type")
  @@index([createdById], map: "idx_member_event_balance_created_by")
  @@index([voidedById], map: "idx_member_event_balance_voided_by")
  @@map("arya_member_event_balance_ledger")
}

model BankAccount {
  id           String   @id @default(uuid()) @map("bank_account_id") @db.Char(36)
  bankCode     String   @map("bank_code") @db.VarChar(30)
  bankName     String   @map("bank_name") @db.VarChar(100)
  accountNo    String   @map("account_no") @db.VarChar(100)
  accountName  String   @map("account_name") @db.VarChar(200)
  currencyCode String   @default("IDR") @map("currency_code") @db.Char(3)
  openingBalance         Decimal?  @map("opening_balance") @db.Decimal(19, 2)
  openingBalanceDate     DateTime? @map("opening_balance_date") @db.Date
  openingBalanceLockedAt DateTime? @map("opening_balance_locked_at") @db.DateTime(3)
  activeFlag   Boolean  @default(true) @map("active_flag")
  createdById  String?  @map("created_by") @db.Char(36)
  updatedById  String?  @map("updated_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  createdBy  User?                 @relation("BankAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy  User?                 @relation("BankAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  statements BankStatementUpload[]

  @@unique([bankCode, accountNo], map: "uk_bank_account_bank_account_no")
  @@map("arya_bank_account")
}

model BankStatementUpload {
  firstSeenMemberIdentities MemberIdentity[]
  id               String    @id @default(uuid()) @map("statement_upload_id") @db.Char(36)
  bankAccountId    String    @map("bank_account_id") @db.Char(36)
  fileName         String    @map("file_name") @db.VarChar(255)
  periodFrom       DateTime? @map("period_from") @db.Date
  periodTo         DateTime? @map("period_to") @db.Date
  totalTransaction Int       @default(0) @map("total_transaction")
  totalCredit      Decimal   @default(0) @map("total_credit") @db.Decimal(20, 2)
  totalDebit       Decimal   @default(0) @map("total_debit") @db.Decimal(20, 2)
  status           String    @default("RAW") @db.VarChar(20)
  uploadedAt       DateTime  @default(now()) @map("uploaded_at") @db.DateTime(0)
  uploadedById     String    @map("uploaded_by") @db.Char(36)
  executedAt       DateTime? @map("executed_at") @db.DateTime(0)
  executedById     String?   @map("executed_by") @db.Char(36)
  finalizedAt      DateTime? @map("finalized_at") @db.DateTime(0)
  finalizedById    String?   @map("finalized_by") @db.Char(36)
  remark           String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  uploadedBy  User        @relation("StatementUploadedBy", fields: [uploadedById], references: [id])
  executedBy  User?       @relation("StatementExecutedBy", fields: [executedById], references: [id])
  finalizedBy User?       @relation("StatementFinalizedBy", fields: [finalizedById], references: [id])
  transactions BankTransaction[]
  approval     ReconciliationApproval?
  correctionProposals ReconciliationCorrectionProposal[]

  @@map("arya_bank_statement_upload")
}

model BankTransaction {
  memberIdentityId String? @map("member_identity_id") @db.Char(36)
  memberIdentity MemberIdentity? @relation(fields: [memberIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_transaction_member_identity")
  @@index([memberIdentityId], map: "idx_bank_transaction_member_identity")
  id                   String    @id @default(uuid()) @map("bank_transaction_id") @db.Char(36)
  statementUploadId    String    @map("statement_upload_id") @db.Char(36)
  rowNo                Int?      @map("row_no")
  transactionDate      DateTime? @map("transaction_date") @db.Date
  transactionType      String?   @map("transaction_type") @db.VarChar(20)
  referenceNo          String?   @map("reference_no") @db.VarChar(150)
  senderName           String?   @map("sender_name") @db.VarChar(255)
  description          String?   @db.Text
  originalAmount       Decimal   @map("original_amount") @db.Decimal(20, 2)
  suffixCode           String?   @map("suffix_code") @db.Char(3)
  suggestedEventCodeId String?   @map("suggested_event_code_id") @db.Char(36)
  eventCodeId          String?   @map("event_code_id") @db.Char(36)
  eventCampaignId      String?   @map("event_campaign_id") @db.Char(36)
  baseAmount           Decimal?  @map("base_amount") @db.Decimal(20, 2)
  status               String    @default("RAW") @db.VarChar(20)
  remark               String?   @db.VarChar(1000)
  sourceType           String    @default("BANK") @map("source_type") @db.VarChar(20)
  correctionReason     String?   @map("correction_reason") @db.VarChar(1000)
  manualAddedAt        DateTime? @map("manual_added_at") @db.DateTime(0)
  manualAddedById      String?   @map("manual_added_by") @db.Char(36)
  reconciliationExcludedAt DateTime? @map("reconciliation_excluded_at") @db.DateTime(0)
  reconciliationExcludedById String? @map("reconciliation_excluded_by") @db.Char(36)
  reconciliationExclusionReason String? @map("reconciliation_exclusion_reason") @db.VarChar(1000)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  statementUpload    BankStatementUpload       @relation(fields: [statementUploadId], references: [id])
  suggestedEventCode EventCode?                @relation("SuggestedEventCode", fields: [suggestedEventCodeId], references: [id])
  eventCode          EventCode?                @relation("FinalEventCode", fields: [eventCodeId], references: [id])
  eventCampaign      EventCampaign?            @relation(fields: [eventCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_transaction_event_campaign")
  manualAddedBy      User?                     @relation("BankTransactionManualAddedBy", fields: [manualAddedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_transaction_manual_added_by")
  reconciliationExcludedBy User?               @relation("BankTransactionExcludedBy", fields: [reconciliationExcludedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_transaction_excluded_by")
  history            BankTransactionHistory[]
  correctionItems    ReconciliationCorrectionItem[]
  memberEventCoverages MemberEventCoverage[]
  memberEventBalanceLedger MemberEventBalanceLedger[]

  @@index([eventCampaignId], map: "idx_bank_transaction_event_campaign")
  @@index([manualAddedById], map: "idx_bank_transaction_manual_added_by")
  @@index([reconciliationExcludedAt], map: "idx_bank_transaction_reconciliation_excluded")
  @@index([reconciliationExcludedById], map: "idx_bank_transaction_excluded_by")
  @@map("arya_bank_transaction")
}

model BankTransactionHistory {
  id                    String   @id @default(uuid()) @map("transaction_history_id") @db.Char(36)
  bankTransactionId     String   @map("bank_transaction_id") @db.Char(36)
  fieldName             String?  @map("field_name") @db.VarChar(100)
  oldValue              String?  @map("old_value") @db.Text
  newValue              String?  @map("new_value") @db.Text
  remark                String?  @db.VarChar(1000)
  changedAt             DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  changedById           String   @map("changed_by") @db.Char(36)

  transaction BankTransaction @relation(fields: [bankTransactionId], references: [id])
  changedBy   User            @relation("TransactionHistoryChangedBy", fields: [changedById], references: [id])

  @@map("arya_bank_transaction_history")
}

model ReconciliationApproval {
  id                String    @id @default(uuid()) @map("approval_id") @db.Char(36)
  statementUploadId String    @unique @map("statement_upload_id") @db.Char(36)
  status            String    @default("PENDING") @db.VarChar(20)
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.DateTime(0)
  submittedById     String    @map("submitted_by") @db.Char(36)
  decidedAt         DateTime? @map("decided_at") @db.DateTime(0)
  decidedById       String?   @map("decided_by") @db.Char(36)
  remark            String?   @db.VarChar(1000)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  statementUpload BankStatementUpload              @relation(fields: [statementUploadId], references: [id])
  submittedBy     User                             @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id])
  decidedBy       User?                            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  history         ReconciliationApprovalHistory[]
  approvers       ReconciliationApprovalApprover[]
  correctionProposals ReconciliationCorrectionProposal[]

  @@index([status, submittedAt])
  @@map("arya_reconciliation_approval")
}

model ReconciliationApprovalApprover {
  id         String   @id @default(uuid()) @map("reconciliation_approval_approver_id") @db.Char(36)
  approvalId String   @map("reconciliation_approval_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  approval ReconciliationApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reconciliation_approval_approver_approval")
  user     User                   @relation("ReconciliationApprovalApproverUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_reconciliation_approval_approver_user")

  @@unique([approvalId, userId], map: "uk_reconciliation_approval_approver")
  @@index([userId], map: "idx_reconciliation_approval_approver_user")
  @@map("arya_reconciliation_approval_approver")
}

model ReconciliationCorrectionProposal {
  id                String    @id @default(uuid()) @map("correction_proposal_id") @db.Char(36)
  approvalId        String    @map("approval_id") @db.Char(36)
  statementUploadId String    @map("statement_upload_id") @db.Char(36)
  status            String    @default("PENDING") @db.VarChar(20)
  proposedAt        DateTime  @default(now()) @map("proposed_at") @db.DateTime(0)
  proposedById      String    @map("proposed_by") @db.Char(36)
  decidedAt         DateTime? @map("decided_at") @db.DateTime(0)
  decidedById       String?   @map("decided_by") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  approval       ReconciliationApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_proposal_approval")
  statementUpload BankStatementUpload @relation(fields: [statementUploadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_proposal_statement")
  proposedBy     User @relation("ReconciliationCorrectionProposedBy", fields: [proposedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_proposal_proposed_by")
  decidedBy      User? @relation("ReconciliationCorrectionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_proposal_decided_by")
  items          ReconciliationCorrectionItem[]
  approvers      ReconciliationCorrectionApprover[]

  @@index([approvalId, status], map: "idx_correction_proposal_approval_status")
  @@index([statementUploadId, status], map: "idx_correction_proposal_statement_status")
  @@index([proposedById], map: "idx_correction_proposal_proposed_by")
  @@index([decidedById], map: "idx_correction_proposal_decided_by")
  @@map("arya_reconciliation_correction_proposal")
}

model ReconciliationCorrectionItem {
  id                    String    @id @default(uuid()) @map("correction_item_id") @db.Char(36)
  proposalId            String    @map("correction_proposal_id") @db.Char(36)
  action                String    @db.VarChar(20)
  bankTransactionId     String?   @map("bank_transaction_id") @db.Char(36)
  beforeEventCodeId     String?   @map("before_event_code_id") @db.Char(36)
  beforeEventCampaignId String?   @map("before_event_campaign_id") @db.Char(36)
  proposedEventCodeId   String?   @map("proposed_event_code_id") @db.Char(36)
  proposedEventCampaignId String? @map("proposed_event_campaign_id") @db.Char(36)
  beforeRemark          String?   @map("before_remark") @db.VarChar(1000)
  proposedRemark        String?   @map("proposed_remark") @db.VarChar(1000)
  correctionReason      String?   @map("correction_reason") @db.VarChar(1000)
  manualTransactionDate DateTime? @map("manual_transaction_date") @db.Date
  manualTransactionType String?   @map("manual_transaction_type") @db.VarChar(20)
  manualDescription     String?   @map("manual_description") @db.Text
  manualOriginalAmount  Decimal?  @map("manual_original_amount") @db.Decimal(20, 2)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  proposal          ReconciliationCorrectionProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_proposal")
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_transaction")
  beforeEventCode   EventCode? @relation("CorrectionBeforeEventCode", fields: [beforeEventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_before_event")
  proposedEventCode EventCode? @relation("CorrectionProposedEventCode", fields: [proposedEventCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_proposed_event")
  beforeEventCampaign EventCampaign? @relation("CorrectionBeforeEventCampaign", fields: [beforeEventCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_before_campaign")
  proposedEventCampaign EventCampaign? @relation("CorrectionProposedEventCampaign", fields: [proposedEventCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_correction_item_proposed_campaign")

  @@index([proposalId, action], map: "idx_correction_item_proposal_action")
  @@index([bankTransactionId], map: "idx_correction_item_transaction")
  @@index([beforeEventCodeId], map: "idx_correction_item_before_event")
  @@index([proposedEventCodeId], map: "idx_correction_item_proposed_event")
  @@index([beforeEventCampaignId], map: "idx_correction_item_before_campaign")
  @@index([proposedEventCampaignId], map: "idx_correction_item_proposed_campaign")
  @@map("arya_reconciliation_correction_item")
}

model ReconciliationCorrectionApprover {
  id         String   @id @default(uuid()) @map("correction_approver_id") @db.Char(36)
  proposalId String   @map("correction_proposal_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
