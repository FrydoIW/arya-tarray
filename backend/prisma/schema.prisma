  @@unique([proposalId, userId], map: "uk_correction_approver")
  @@index([userId], map: "idx_correction_approver_user")
  @@map("arya_reconciliation_correction_approver")
}

model ReconciliationApprovalHistory {
  id           String   @id @default(uuid()) @map("approval_history_id") @db.Char(36)
