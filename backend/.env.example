# MySQL database used by Arya Tarray.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/arya_tarray"

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Optional login throttle. Values shown are the application defaults.
LOGIN_RATE_LIMIT_MAX_FAILURES=8
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_COOLDOWN_MS=900000

# Number of trusted reverse-proxy hops. Keep 0 unless the API is behind a
# proxy that overwrites the client IP; otherwise all clients share one bucket.
TRUSTED_PROXY_HOPS=0

# Used by `npm run db:seed -w backend` only when the bootstrap admin does not exist.
# Never commit a real password. Existing admin credentials are never reset by the seed.
BOOTSTRAP_ADMIN_EMAIL=admin@aryatarray.local
BOOTSTRAP_ADMIN_NAME=Arya Tarray Admin
BOOTSTRAP_ADMIN_PASSWORD=
