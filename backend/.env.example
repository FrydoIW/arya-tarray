# Placeholder template only. Actual local configuration is private backend/.env.
# .env.dev.local.txt / .env.prod.local.txt are manual references, never auto-loaded.
ARYA_ENV=DEV
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/arya_tarray_dev"
TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/arya_tarray_dev"
# Explicit opt-in for fixture-scoped writes on shared DEV; tests refuse false/missing.
ALLOW_DEV_INTEGRATION_WRITES=false

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Required first day of a month. Local DEV approval: 2026-10-01; NOT PROD approval.
# Future PROD must omit TEST_DATABASE_URL and have a separately approved cutover.
ACCOUNTING_CUTOVER_DATE=

# Used by `npm run db:seed -w backend` only when the bootstrap admin does not exist.
# Never commit a real password. Existing admin credentials are never reset by the seed.
BOOTSTRAP_ADMIN_EMAIL=admin@aryatarray.local
BOOTSTRAP_ADMIN_NAME=Arya Tarray Admin
BOOTSTRAP_ADMIN_PASSWORD=
