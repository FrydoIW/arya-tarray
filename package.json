{
  "name": "arya-tarray-dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "productName": "Arya Tarray",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c auto \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "test": "npm run test -w backend",
    "test:db:bootstrap": "npm run test:db:bootstrap -w backend",
    "test:db:verify": "npm run test:db:verify -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:browser": "npm run test:browser -w frontend",
    "test:full": "npm test && npm run test:integration && npm run test:browser"
  },
  "build": {
    "appId": "org.aryatarray.desktop",
    "productName": "Arya Tarray",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": ".desktop-build/release" },
    "files": ["desktop/main.cjs", "package.json"],
    "extraResources": [{ "from": ".desktop-build/runtime", "to": "runtime" }],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AryaTarray-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
